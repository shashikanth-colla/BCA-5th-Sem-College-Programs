#include <stdio.h>

int main()
{
    int a[20], n, i, key, pos = -1;
    int low, high, mid;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter sorted elements: ");

    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    printf("Enter key: ");
    scanf("%d", &key);

    // Linear Search
    for(i = 0; i < n; i++)
    {
        if(a[i] == key)
        {
            pos = i;
            break;
        }
    }

    if(pos != -1)
        printf("Linear Search: Found at position %d\n", pos + 1);
    else
        printf("Linear Search: Not found\n");

    // Binary Search
    low = 0;
    high = n - 1;
    pos = -1;

    while(low <= high)
    {
        mid = (low + high) / 2;

        if(a[mid] == key)
        {
            pos = mid;
            break;
        }

        if(a[mid] < key)
            low = mid + 1;
        else
            high = mid - 1;
    }

    if(pos != -1)
        printf("Binary Search: Found at position %d\n", pos + 1);
    else
        printf("Binary Search: Not found\n");

    return 0;
}
